generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  admin
  operator
  reviewer
}

enum ContentJobStatus {
  requested
  running
  succeeded
  failed
}

enum ProviderConnectionKind {
  social
  google_ads
  meta_ads
}

enum ProviderConnectionStatus {
  pending
  connected
  disconnected
  expired
  error
}

enum SocialAccountType {
  facebook
  instagram
  linkedin
  x
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships         Membership[]
  brandBrief          BrandBrief?
  contentRequests     ContentRequest[]
  contentDrafts       ContentDraft[]
  generationJobs      GenerationJob[]
  providerConnections ProviderConnection[]
  auditLogs           AuditLog[]

  @@map("workspaces")
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  supabaseAuthId     String?  @unique @map("supabase_auth_id")
  name               String?
  currentWorkspaceId String?  @map("current_workspace_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  memberships     Membership[]
  contentRequests ContentRequest[]
  auditLogs       AuditLog[]

  @@map("users")
}

model Membership {
  id          String         @id @default(cuid())
  workspaceId String         @map("workspace_id")
  userId      String         @map("user_id")
  role        MembershipRole
  createdAt   DateTime       @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("memberships")
}

model BrandBrief {
  id               String   @id @default(cuid())
  workspaceId      String   @unique @map("workspace_id")
  name             String
  tone             String?
  approvedFacts    String?  @map("approved_facts") @db.Text
  prohibitedClaims String?  @map("prohibited_claims") @db.Text
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contentRequests ContentRequest[]

  @@map("brand_briefs")
}

model ContentRequest {
  id              String           @id @default(cuid())
  workspaceId     String           @map("workspace_id")
  createdByUserId String?          @map("created_by_user_id")
  brandBriefId    String?          @map("brand_brief_id")
  status          ContentJobStatus @default(requested)
  prompt          String?          @db.Text
  input           Json?
  idempotencyKey  String?          @map("idempotency_key")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdByUser  User?           @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  brandBrief     BrandBrief?     @relation(fields: [brandBriefId], references: [id], onDelete: SetNull)
  generationJobs GenerationJob[]
  drafts         ContentDraft[]

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId])
  @@index([brandBriefId])
  @@index([createdByUserId])
  @@map("content_requests")
}

model GenerationJob {
  id               String           @id @default(cuid())
  workspaceId      String           @map("workspace_id")
  contentRequestId String           @unique @map("content_request_id")
  status           ContentJobStatus @default(requested)
  provider         String
  promptVersion    String           @map("prompt_version")
  errorCode        String?          @map("error_code")
  errorMessage     String?          @map("error_message") @db.Text
  startedAt        DateTime?        @map("started_at")
  completedAt      DateTime?        @map("completed_at")
  usageMetadata    Json?            @map("usage_metadata")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  leaseExpiresAt   DateTime?        @map("lease_expires_at")
  leaseWorkerId    String?          @map("lease_worker_id")
  retryCount       Int              @default(0) @map("retry_count")
  maxRetries       Int              @default(3) @map("max_retries")
  nextRetryAt      DateTime?        @map("next_retry_at")
  operationId      String?          @map("operation_id")
  deadLetteredAt   DateTime?        @map("dead_lettered_at")
  deadLetterReason String?          @map("dead_letter_reason") @db.Text

  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contentRequest ContentRequest @relation(fields: [contentRequestId], references: [id], onDelete: Cascade)
  draft          ContentDraft?

  @@index([workspaceId])
  @@index([status])
  @@index([status, leaseExpiresAt, nextRetryAt])
  @@index([operationId])
  @@map("generation_jobs")
}

model ContentDraft {
  id               String   @id @default(cuid())
  workspaceId      String   @map("workspace_id")
  contentRequestId String   @unique @map("content_request_id")
  generationJobId  String?  @unique @map("generation_job_id")
  title            String?
  body             String   @db.Text
  version          Int      @default(1)
  provider         String?
  promptVersion    String?  @map("prompt_version")
  metadata         Json?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contentRequest ContentRequest @relation(fields: [contentRequestId], references: [id], onDelete: Cascade)
  generationJob  GenerationJob? @relation(fields: [generationJobId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@map("content_drafts")
}

/// Workspace-scoped external provider connection (social or ads).
model ProviderConnection {
  id                 String                   @id @default(cuid())
  workspaceId        String                   @map("workspace_id")
  kind               ProviderConnectionKind
  /// Stable key: facebook|instagram|linkedin|x|google_ads|meta_ads
  externalKey        String                   @map("external_key")
  accountType        SocialAccountType?       @map("account_type")
  status             ProviderConnectionStatus @default(pending)
  externalAccountId  String?                  @map("external_account_id")
  scopes             String[]                 @default([])
  displayName        String?                  @map("display_name")
  canReadAds         Boolean?                 @map("can_read_ads")
  missingPermissions String[]                 @default([]) @map("missing_permissions")
  lastHealthAt       DateTime?                @map("last_health_at")
  lastHealthMessage  String?                  @map("last_health_message") @db.Text
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  workspace  Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  credential ProviderCredential?

  @@unique([workspaceId, externalKey])
  @@index([workspaceId])
  @@index([kind])
  @@index([status])
  @@map("provider_connections")
}

/// Encrypted OAuth tokens — never returned by API responses.
model ProviderCredential {
  id              String    @id @default(cuid())
  connectionId    String    @unique @map("connection_id")
  accessTokenEnc  String    @map("access_token_enc") @db.Text
  refreshTokenEnc String?   @map("refresh_token_enc") @db.Text
  tokenExpiresAt  DateTime? @map("token_expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  connection ProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@map("provider_credentials")
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  actorId     String   @map("actor_id")
  action      String
  resource    String
  resourceId  String?  @map("resource_id")
  payload     Json?
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User      @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}

